<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="pipet_final">

  <!-- RENKLER -->
  <material name="white">
    <color rgba="0.92 0.94 0.97 1"/>
  </material>

  <material name="blue">
    <color rgba="0.05 0.30 0.85 1"/>
  </material>

  <material name="silver">
    <color rgba="0.70 0.75 0.80 1"/>
  </material>

  <material name="black">
    <color rgba="0.10 0.12 0.15 1"/>
  </material>

  <!-- SILINDIR MAKROSU -->
  <xacro:macro name="cylinder_part"
    params="name radius length mass x y z roll pitch yaw color">

    <link name="${name}">

      <visual>
        <origin xyz="${x} ${y} ${z}"
                rpy="${roll} ${pitch} ${yaw}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${color}"/>
      </visual>

      <collision>
        <origin xyz="${x} ${y} ${z}"
                rpy="${roll} ${pitch} ${yaw}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="${x} ${y} ${z}"
                rpy="${roll} ${pitch} ${yaw}"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass*(3*radius*radius+length*length)/12}"
          ixy="0"
          ixz="0"
          iyy="${mass*(3*radius*radius+length*length)/12}"
          iyz="0"
          izz="${mass*radius*radius/2}"/>
      </inertial>

    </link>
  </xacro:macro>

  <!-- DUNYA -->
  <link name="world"/>

  <!-- TABAN -->
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05"/>
  </joint>

  <xacro:cylinder_part
    name="base_link"
    radius="0.11" length="0.10" mass="4.0"
    x="0" y="0" z="0"
    roll="0" pitch="0" yaw="0"
    color="white"/>

  <!-- ANA GOVDE -->
  <joint name="column_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="column_link"/>
    <origin xyz="0 0 0.05"/>
  </joint>

  <xacro:cylinder_part
    name="column_link"
    radius="0.055" length="0.20" mass="1.0"
    x="0" y="0" z="0.10"
    roll="0" pitch="0" yaw="0"
    color="silver"/>

  <!-- JOINT 1 -->
  <joint name="joint1" type="revolute">
    <parent link="column_link"/>
    <child link="arm1_link"/>
    <origin xyz="0 0 0.20"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57"
           effort="50" velocity="0.6"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- BIRINCI KOL -->
  <xacro:cylinder_part
    name="arm1_link"
    radius="0.030" length="0.22" mass="0.8"
    x="0.11" y="0" z="0"
    roll="0" pitch="1.57079632679" yaw="0"
    color="white"/>

  <!-- BIRINCI MOTOR KAPAGI -->
  <joint name="motor1_fixed" type="fixed">
    <parent link="arm1_link"/>
    <child link="motor1_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <xacro:cylinder_part
    name="motor1_link"
    radius="0.060" length="0.065" mass="0.25"
    x="0" y="0" z="0"
    roll="0" pitch="0" yaw="0"
    color="blue"/>

  <!-- JOINT 2 -->
  <joint name="joint2" type="revolute">
    <parent link="arm1_link"/>
    <child link="arm2_link"/>
    <origin xyz="0.22 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0"
           effort="30" velocity="0.6"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- IKINCI KOL -->
  <xacro:cylinder_part
    name="arm2_link"
    radius="0.025" length="0.18" mass="0.5"
    x="0.09" y="0" z="0"
    roll="0" pitch="1.57079632679" yaw="0"
    color="white"/>

  <!-- IKINCI MOTOR KAPAGI -->
  <joint name="motor2_fixed" type="fixed">
    <parent link="arm2_link"/>
    <child link="motor2_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <xacro:cylinder_part
    name="motor2_link"
    radius="0.048" length="0.080" mass="0.20"
    x="0" y="0" z="0"
    roll="0" pitch="0" yaw="0"
    color="blue"/>

  <!-- DIKEY KIZAK GOVDESI -->
  <joint name="housing_fixed" type="fixed">
    <parent link="arm2_link"/>
    <child link="housing_link"/>
    <origin xyz="0.18 0 0"/>
  </joint>

  <xacro:cylinder_part
    name="housing_link"
    radius="0.032" length="0.12" mass="0.20"
    x="0" y="0" z="-0.06"
    roll="0" pitch="0" yaw="0"
    color="silver"/>

  <!-- JOINT 3 -->
  <joint name="joint3" type="prismatic">
    <parent link="arm2_link"/>
    <child link="carriage_link"/>
    <origin xyz="0.18 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.08"
           effort="40" velocity="0.03"/>
    <dynamics damping="2.0"/>
  </joint>

  <!-- PIPET TASIYICI -->
  <xacro:cylinder_part
    name="carriage_link"
    radius="0.016" length="0.10" mass="0.15"
    x="0" y="0" z="-0.05"
    roll="0" pitch="0" yaw="0"
    color="blue"/>

  <!-- PIPET -->
  <joint name="pipette_fixed" type="fixed">
    <parent link="carriage_link"/>
    <child link="pipette_link"/>
    <origin xyz="0 0 -0.10"/>
  </joint>

  <xacro:cylinder_part
    name="pipette_link"
    radius="0.007" length="0.09" mass="0.05"
    x="0" y="0" z="-0.045"
    roll="0" pitch="0" yaw="0"
    color="black"/>

  <!-- PIPET UCU -->
  <joint name="tip_fixed" type="fixed">
    <parent link="pipette_link"/>
    <child link="tip_link"/>
    <origin xyz="0 0 -0.09"/>
  </joint>

  <xacro:cylinder_part
    name="tip_link"
    radius="0.002" length="0.025" mass="0.005"
    x="0" y="0" z="-0.0125"
    roll="0" pitch="0" yaw="0"
    color="silver"/>

  <!-- UC EFEKTOR -->
  <link name="tool0"/>

  <joint name="tool0_fixed" type="fixed">
    <parent link="tip_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 -0.025"/>
  </joint>

  <!-- IKINCI KOL UCU BAGLANTI FLANSI -->
  <joint name="end_flange_fixed" type="fixed">
    <parent link="arm2_link"/>
    <child link="end_flange_link"/>
    <origin xyz="0.18 0 -0.045"/>
  </joint>

  <link name="end_flange_link">
    <visual>
      <geometry>
        <cylinder radius="0.039" length="0.140"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.00006" ixy="0" ixz="0"
               iyy="0.00006" iyz="0"
               izz="0.00008"/>
    </inertial>
  </link>

  <!-- KAMERA BAGLANTI APARATI -->
  <joint name="camera_bracket_fixed" type="fixed">
    <parent link="arm2_link"/>
    <child link="camera_bracket_link"/>
    <origin xyz="0.12 0.023 -0.020"/>
  </joint>

  <link name="camera_bracket_link">
    <visual>
      <origin xyz="0 0.012 0"/>
      <geometry>
        <box size="0.025 0.045 0.020"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <!-- KAMERA GOVDESI -->
  <joint name="camera_fixed" type="fixed">
    <parent link="camera_bracket_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.028 -0.015"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.045 0.040 0.035"/>
      </geometry>
      <material name="black"/>
    </visual>

    <!-- ASAGI BAKAN LENS -->
    <visual>
      <origin xyz="0 0 -0.021"/>
      <geometry>
        <cylinder radius="0.012" length="0.012"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.045 0.040 0.035"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.08"/>
      <inertia
        ixx="0.00002" ixy="0" ixz="0"
        iyy="0.00002" iyz="0"
        izz="0.00002"/>
    </inertial>
  </link>

  <!-- GAZEBO KAMERA SENSORU -->
  <gazebo reference="camera_link">
    <sensor name="pipet_camera" type="camera">
      <pose>0 0 -0.03 0 1.20 0</pose>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/pipet_camera/image</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>


  <!-- IKINCI MOTOR UST KAPAGI -->
  <joint name="motor2_top_fixed" type="fixed">
    <parent link="motor2_link"/>
    <child link="motor2_top_cap"/>
    <origin xyz="0 0 0.038"/>
  </joint>

  <link name="motor2_top_cap">
    <visual>
      <geometry>
        <cylinder radius="0.049" length="0.012"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  <!-- ROS 2 CONTROL -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- GAZEBO CONTROL PLUGIN -->

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>/home/ummahantemel/pipet_final_ws/src/pipet_final/config/controllers.yaml</parameters>

    </plugin>
  </gazebo>
</robot>


